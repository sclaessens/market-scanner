{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-scanner.local/schemas/data11-governance-artifacts-v1.json",
  "title": "ME-DATA11 governance artifacts",
  "oneOf": [
    {"$ref": "#/$defs/run30Authority"},
    {"$ref": "#/$defs/downstreamAuthority"},
    {"$ref": "#/$defs/sourceEvidence"},
    {"$ref": "#/$defs/mappingReview"},
    {"$ref": "#/$defs/approvalDecision"},
    {"$ref": "#/$defs/downstreamMeasurement"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "binding": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "run30Authority": {
      "type": "object",
      "required": ["schema_version", "authority_id", "run_id", "ranking_scope", "canonical_universe_version", "canonical_universe_size", "trusted_artifacts"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-run30-input-authority-v1"},
        "authority_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "ranking_scope": {"const": "technical_setup_screening"},
        "canonical_universe_version": {"type": "string", "minLength": 1},
        "canonical_universe_size": {"type": "integer", "minimum": 1},
        "trusted_artifacts": {
          "type": "object",
          "required": ["run30_ranking", "run30_manifest", "run30_universe_index", "canonical_universe"],
          "additionalProperties": {"$ref": "#/$defs/binding"}
        }
      },
      "additionalProperties": false
    },
    "downstreamAuthority": {
      "type": "object",
      "required": ["schema_version", "authority_id", "canonical_universe_version", "canonical_universe_size", "trusted_artifacts"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-downstream-prestate-authority-v1"},
        "authority_id": {"type": "string", "minLength": 1},
        "canonical_universe_version": {"type": "string", "minLength": 1},
        "canonical_universe_size": {"type": "integer", "minimum": 1},
        "trusted_artifacts": {
          "type": "object",
          "required": ["data06_manifest", "data06_summary", "data06_per_ticker", "run31_compact_index", "run31_evidence_summary", "run31_top_level_checksums"],
          "additionalProperties": {"$ref": "#/$defs/binding"}
        }
      },
      "additionalProperties": false
    },
    "sourceEvidence": {
      "type": "object",
      "required": ["schema_version", "ticker", "instrument_id", "issuer_identity", "cik", "official_source_url", "full_source_snapshot_sha256", "accounting_framework", "observations", "boundary"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-minimal-primary-source-evidence-v1"},
        "ticker": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "issuer_identity": {"type": "string", "minLength": 1},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "official_source_url": {"type": "string", "pattern": "^https://data\\.sec\\.gov/"},
        "full_source_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "accounting_framework": {"const": "us_gaap"},
        "observations": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "boundary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "mappingReview": {
      "type": "object",
      "required": ["schema_version", "decision", "ticker", "mappings", "limitations"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-canonical-mapping-review-v1"},
        "decision": {"enum": ["pending", "approved", "rejected", "blocked"]},
        "ticker": {"type": "string", "minLength": 1},
        "mappings": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "string"}, {"type": "string"}, {"type": "string"}], "items": false}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "approvalDecision": {
      "type": "object",
      "required": ["schema_version", "decision_id", "decision", "ticker", "instrument_id", "issuer_identity", "cik", "reporting_period", "reviewer_roles", "reviews", "approved_derived_metrics", "approved_calculation_checksums", "artifact_bindings", "limitations"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-approval-decision-v1"},
        "decision_id": {"type": "string", "minLength": 1},
        "decision": {"enum": ["pending", "approved", "rejected", "blocked"]},
        "ticker": {"type": "string", "minLength": 1},
        "instrument_id": {"type": "string", "minLength": 1},
        "issuer_identity": {"type": "string", "minLength": 1},
        "cik": {"type": "string", "pattern": "^[0-9]{10}$"},
        "reporting_period": {"type": "string", "minLength": 1},
        "reviewer_roles": {"type": "array", "minItems": 3, "items": {"type": "string"}},
        "reviews": {"type": "object", "minProperties": 13, "additionalProperties": {"type": "object", "required": ["status"], "properties": {"status": {"enum": ["pending", "approved", "rejected", "blocked"]}}, "additionalProperties": false}},
        "approved_derived_metrics": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "approved_calculation_checksums": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256"}},
        "artifact_bindings": {"type": "object", "minProperties": 7, "additionalProperties": {"$ref": "#/$defs/binding"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "downstreamMeasurement": {
      "type": "object",
      "required": ["schema_version", "measurement_status", "reason_codes", "before", "after_authoritative", "rows", "regressions_outside_selected_cohort", "downstream_executed"],
      "properties": {
        "schema_version": {"const": "market-engine-data11-downstream-readiness-delta-v2"},
        "measurement_status": {"enum": ["measured", "unknown_not_measured"]},
        "reason_codes": {"type": "array", "items": {"type": "string"}},
        "before": {"type": ["object", "null"]},
        "after_authoritative": {"type": ["object", "null"]},
        "rows": {"type": "array", "items": {"type": "object"}},
        "regressions_outside_selected_cohort": {"type": ["integer", "string"]},
        "downstream_executed": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  }
}
