{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "market-engine-derived-positions-v1",
  "title": "Transaction-derived portfolio positions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "portfolio_id",
    "projection_timestamp",
    "ledger_digest",
    "ledger_event_count",
    "active_transaction_count",
    "cost_basis_method",
    "positions",
    "portfolio_accounts",
    "calculation_status"
  ],
  "properties": {
    "schema_version": {"const": "market-engine-derived-positions-v1"},
    "portfolio_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "projection_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ledger_event_count": {"type": "integer", "minimum": 0},
    "active_transaction_count": {"type": "integer", "minimum": 0},
    "cost_basis_method": {"const": "moving_weighted_average_v1"},
    "portfolio_accounts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "calculation_status": {"enum": ["complete", "partial"]},
    "positions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "portfolio_id",
          "account_id",
          "instrument_id",
          "canonical_ticker",
          "quantity",
          "position_status",
          "weighted_average_cost",
          "cumulative_fees",
          "remaining_cost_basis",
          "realized_profit_loss",
          "transaction_currency",
          "first_transaction_date",
          "last_transaction_date",
          "last_confirmed_transaction_id",
          "transaction_count",
          "projection_timestamp",
          "ledger_digest",
          "transaction_references",
          "calculation_status",
          "calculation_blockers"
        ],
        "properties": {
          "portfolio_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
          "account_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
          "instrument_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
          "canonical_ticker": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._^:-]{0,49}$"},
          "quantity": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "position_status": {"enum": ["open", "closed"]},
          "weighted_average_cost": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "cumulative_fees": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "remaining_cost_basis": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "realized_profit_loss": {"type": ["string", "null"], "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
          "transaction_currency": {"enum": ["AUD", "CAD", "CHF", "DKK", "EUR", "GBP", "HKD", "JPY", "NOK", "SEK", "USD"]},
          "first_transaction_date": {"type": "string", "format": "date"},
          "last_transaction_date": {"type": "string", "format": "date"},
          "last_confirmed_transaction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
          "transaction_count": {"type": "integer", "minimum": 1},
          "projection_timestamp": {"type": ["string", "null"], "format": "date-time"},
          "ledger_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "transaction_references": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"}},
          "calculation_status": {"enum": ["complete", "partial"]},
          "calculation_blockers": {"type": "array", "uniqueItems": true, "items": {"enum": ["FEE_VALUE_UNAVAILABLE", "COST_BASIS_UNAVAILABLE", "REALIZED_PROFIT_LOSS_UNAVAILABLE"]}}
        }
      }
    }
  }
}
