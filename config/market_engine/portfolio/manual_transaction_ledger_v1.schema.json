{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manual-portfolio-transaction-ledger-v1",
  "title": "Manual portfolio transaction ledger event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_type",
    "transaction_id",
    "portfolio_id",
    "account_id",
    "instrument_id",
    "canonical_ticker",
    "transaction_type",
    "trade_date",
    "execution_timestamp",
    "quantity",
    "unit_price",
    "trade_currency",
    "fee",
    "broker_account_label",
    "source_type",
    "recorded_at",
    "note",
    "external_reference",
    "corrects_transaction_id",
    "reverses_transaction_id",
    "reason"
  ],
  "properties": {
    "schema_version": {"const": "manual-portfolio-transaction-ledger-v1"},
    "event_type": {"enum": ["transaction", "correction", "reversal"]},
    "transaction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "portfolio_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "account_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "instrument_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "canonical_ticker": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._^:-]{0,49}$"},
    "transaction_type": {"type": ["string", "null"], "enum": ["BUY", "SELL", null]},
    "trade_date": {"type": ["string", "null"], "format": "date"},
    "execution_timestamp": {"type": ["string", "null"], "format": "date-time"},
    "quantity": {"type": ["string", "null"], "pattern": "^(0\\.[0-9]*[1-9][0-9]*|[1-9][0-9]*(\\.[0-9]+)?)$"},
    "unit_price": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "trade_currency": {"enum": ["AUD", "CAD", "CHF", "DKK", "EUR", "GBP", "HKD", "JPY", "NOK", "SEK", "USD", null]},
    "fee": {
      "type": "object",
      "additionalProperties": false,
      "required": ["availability", "amount", "currency"],
      "properties": {
        "availability": {"enum": ["available", "unavailable"]},
        "amount": {"type": ["string", "null"], "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
        "currency": {"enum": ["AUD", "CAD", "CHF", "DKK", "EUR", "GBP", "HKD", "JPY", "NOK", "SEK", "USD", null]}
      }
    },
    "broker_account_label": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "source_type": {"const": "manual_user_input"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "note": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "external_reference": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000},
    "corrects_transaction_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "reverses_transaction_id": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"},
    "reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 2000}
  },
  "allOf": [
    {
      "if": {"properties": {"fee": {"properties": {"availability": {"const": "unavailable"}}}}},
      "then": {"properties": {"fee": {"properties": {"amount": {"const": null}, "currency": {"const": null}}}}}
    },
    {
      "if": {"properties": {"fee": {"properties": {"availability": {"const": "available"}}}}},
      "then": {"properties": {"fee": {"properties": {"amount": {"type": "string"}, "currency": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"event_type": {"const": "transaction"}}},
      "then": {"properties": {
        "transaction_type": {"enum": ["BUY", "SELL"]}, "trade_date": {"type": "string"},
        "quantity": {"type": "string"}, "unit_price": {"type": "string"}, "trade_currency": {"type": "string"},
        "corrects_transaction_id": {"const": null}, "reverses_transaction_id": {"const": null}, "reason": {"const": null}
      }}
    },
    {
      "if": {"properties": {"event_type": {"const": "correction"}}},
      "then": {"properties": {
        "transaction_type": {"enum": ["BUY", "SELL"]}, "trade_date": {"type": "string"},
        "quantity": {"type": "string"}, "unit_price": {"type": "string"}, "trade_currency": {"type": "string"},
        "corrects_transaction_id": {"type": "string"}, "reverses_transaction_id": {"const": null}, "reason": {"type": "string"}
      }}
    },
    {
      "if": {"properties": {"event_type": {"const": "reversal"}}},
      "then": {"properties": {
        "transaction_type": {"const": null}, "trade_date": {"const": null}, "execution_timestamp": {"const": null},
        "quantity": {"const": null}, "unit_price": {"const": null}, "trade_currency": {"const": null},
        "fee": {"const": {"availability": "unavailable", "amount": null, "currency": null}},
        "corrects_transaction_id": {"const": null}, "reverses_transaction_id": {"type": "string"}, "reason": {"type": "string"}
      }}
    }
  ]
}
